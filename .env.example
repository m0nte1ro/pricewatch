# Copy to /etc/pricewatch/pricewatch.env for systemd, or .env for local development.
PRICEWATCH_DATA_DIR=/var/lib/pricewatch
# Optional override. SQLite is the supported database in this release.
# PRICEWATCH_DATABASE_URL=sqlite:////var/lib/pricewatch/pricewatch.db
PRICEWATCH_SCHEDULER_ENABLED=true
PRICEWATCH_LOG_LEVEL=INFO
# Retailer, interval, browser and ntfy settings are configured through the Web UI.
# One Uvicorn worker only: the scheduler and rate limiter run inside this process.
